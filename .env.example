# --- Chat model (all free / local) -----------------------------------------
# gemini: free key at https://aistudio.google.com/apikey
# groq:   free key at https://console.groq.com/keys
# ollama: local, no key (ollama pull qwen2.5:3b && ollama pull nomic-embed-text)
LLM_PROVIDER=gemini
LLM_API_KEY=
# LLM_MODEL=gemini-flash-latest

# --- Embeddings ---------------------------------------------------------------
# gemini | ollama | local (offline word hashing, no key, lower quality)
EMBED_PROVIDER=gemini
# EMBED_API_KEY=   # defaults to LLM_API_KEY

# --- Vector store: numpy (files in data/index) | pgvector (docker compose) ----
VECTOR_STORE=numpy
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assistant

# --- Odoo: mock (demo dataset) | live ----------------------------------------
ODOO_MODE=mock
# ODOO_URL=https://mycompany.odoo.com
# ODOO_DB=mycompany
# ODOO_USER=api@mycompany.com
# ODOO_API_KEY=
